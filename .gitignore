# Python environments, bytecode, and test/coverage output
.venv/
venv/
env/
__pycache__/
.pytest_cache/
*.py[cod]
*.pyd
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Reproducible pipeline outputs; keep reviewed inputs and source evidence tracked.
data/processed/*
!data/processed/.gitkeep

# Incoming source documents may be copyrighted; retain local copies, but do not publish them by default.
data/intake/incoming/*.pdf

# Local editor settings
.vscode/

# Power BI Desktop local cache and transient recovery files.
# Keep .pbix, .pbip, .pbit, and their project source files eligible for version control.
.pbi/
*.pbix.autosave
*.pbix.tmp
*.pbit.autosave

# Temporary editor/Office files
~$*.xlsx
~$*.xlsm
